# Copia questo file in ".env" e personalizza i valori.
# Se lasci tutto com'è, corrisponde al database avviato da docker-compose.yml

SECRET_KEY=cambia-questa-chiave-con-un-valore-lungo-e-casuale

PGUSER=timetrack
PGPASSWORD=timetrack
PGHOST=localhost
PGPORT=5432
PGDATABASE=timetrack

# In alternativa puoi impostare direttamente l'URL completo,
# che ha la precedenza sui valori PG* sopra:
# DATABASE_URL=postgresql+psycopg2://utente:password@host:5432/nomedb
